{
  "name": "abueguias",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:root": "cross-env NEXT_PUBLIC_BASE_PATH= next build",
    "build:pages": "cross-env NEXT_PUBLIC_BASE_PATH=/abueguias next build",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "audit:export": "tsx scripts/audit-export.ts",
    "check": "npm run typecheck && npm run validate:content && npm run test"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "15.5.25",
    "@types/mdx": "2.0.13",
    "next": "15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "cross-env": "7.0.3",
    "tsx": "4.20.5",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
